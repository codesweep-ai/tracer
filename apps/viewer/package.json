{
  "name": "tracer-viewer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:single && npm run build:split && npm run assert:builds",
    "build:single": "tsc --noEmit && vite build --config vite.single.config.ts",
    "build:split": "vite build --config vite.split.config.ts",
    "assert:builds": "node scripts/assert-builds.mjs",
    "parity": "node scripts/parity.mjs",
    "test": "vitest run",
    "lint": "eslint src scripts *.config.ts *.config.js --max-warnings 0"
  },
  "dependencies": {
    "@codesweep-ai/ui": "file:../../ui/codesweep-ui",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@codesweep-ai/eslint-plugin": "file:../../ui/codesweep-eslint-plugin",
    "@eslint/js": "^9.17.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.17.0",
    "eslint-plugin-react": "^7.37.3",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^14.0.0",
    "jsdom": "^25.0.1",
    "playwright-core": "^1.62.1",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.19.1",
    "vite": "^6.0.7",
    "vite-plugin-singlefile": "^2.2.0",
    "vitest": "^2.1.8"
  }
}
